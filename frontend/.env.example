# ==============================================================================
# NIRNAY AI Multi-Agent Wargaming Platform - Environment Configuration
# Obtain API keys at: https://build.nvidia.com
# ==============================================================================

# NVIDIA NIM API Keys (Can share one key across all roles or use separate keys)
ORCHESTRATOR_API_KEY=nvapi-your-key-here
ENV_ANALYSIS_API_KEY=nvapi-your-key-here
RED_TEAM_API_KEY=nvapi-your-key-here
BLUE_TEAM_API_KEY=nvapi-your-key-here
EVALUATION_API_KEY=nvapi-your-key-here
SIMULATOR_API_KEY=nvapi-your-key-here

# Primary model for reasoning agents (Orchestrator, Environment, Blue Team, Red Team)
NVIDIA_MODEL_NAME=nvidia/nemotron-3-super-120b-a12b

# Dedicated model for strategic evaluation, transitions, and safety analysis
EVALUATION_MODEL=nvidia/nemotron-3-super-120b-a12b

# Execution Controls
NUM_RETRIES=3
LLM_TIMEOUT=60.0
ALLOW_FALLBACKS=true