# ============================================================
# NIRNAY / WARGAMING-AI
# Global Repository .gitignore
# ============================================================


# ============================================================
# PYTHON — Backend + AI Agents
# ============================================================

__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
*.so

# Python virtual environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Python packaging
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# Python caches
.pytest_cache/
.mypy_cache/
.pytype/
.pyre/
.ruff_cache/
.pyright/
.hypothesis/

# Coverage
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover
.tox/
.nox/

# Jupyter
.ipynb_checkpoints/


# ============================================================
# ENVIRONMENT VARIABLES / API KEYS / SECRETS
# ============================================================

# Generic environment files
.env
.env.*
!.env.example

# Backend secrets
backend/.env
backend/.env.*
!backend/.env.example

# AI / Agent secrets
backend/agents/.env
backend/agents/.env.*
!backend/agents/.env.example

# Frontend secrets
frontend/.env
frontend/.env.*
!frontend/.env.example

# Frontend framework environment files
frontend/.env.local
frontend/.env.development.local
frontend/.env.test.local
frontend/.env.production.local

# Local configuration files that may contain secrets
secrets/
secret/
credentials/
credentials.json
secrets.json
config.local.*
settings.local.*

# Private keys / certificates
*.pem
*.key
*.crt
*.cer
*.p12
*.pfx
*.jks
*.keystore

# SSH keys accidentally placed in repository
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub

# Cloud/provider credentials
.aws/
.gcloud/
.azure/
.firebase/


# ============================================================
# FRONTEND — Node / React / Vite / Next.js
# ============================================================

# Dependencies
node_modules/

# Build output
dist/
build/
.vite/
.next/
out/

# Framework caches
.cache/
.parcel-cache/
.turbo/
.vercel/

# TypeScript build artifacts
*.tsbuildinfo

# Package manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Package manager caches
.npm/
.yarn/
.pnpm-store/

# Local frontend configuration
*.local


# ============================================================
# API KEYS / CLIENT-SIDE SECRET FILES
# ============================================================

# Common local API configuration files
api_keys.json
api-key.json
apikey.json
keys.json
secrets.json
credentials.json

# Local AI configuration
llm_config.local.*
agent_config.local.*
ai_config.local.*

# Firebase / Google
firebase-debug.log
.firebase/
google-services.json
GoogleService-Info.plist

# IMPORTANT:
# NEXT_PUBLIC_* and VITE_* variables are normally exposed
# to the browser. NEVER put private API keys in these variables.


